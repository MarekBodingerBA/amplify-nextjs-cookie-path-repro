# Copy to .env.local and fill in. .env.local is git-ignored.

# Cognito user pool + app client (no client secret, USER_SRP_AUTH allowed).
NEXT_PUBLIC_USER_POOL_ID=
NEXT_PUBLIC_USER_POOL_CLIENT_ID=
# Cognito identity pool with guest (unauthenticated) access enabled and the user pool above as an
# authentication provider.
NEXT_PUBLIC_IDENTITY_POOL_ID=

# A user you created yourself in that user pool, with a permanent password (status CONFIRMED, see the README).
# The app has no sign-up. Only flow:path-bug reads these.
REPRO_USERNAME=
REPRO_PASSWORD=

# Where the app runs. Defaults to http://localhost:3000.
# REPRO_BASE_URL=http://localhost:3000
